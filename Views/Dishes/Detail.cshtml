@model Dish_BIT240009
@{
    ViewData["Title"] = L["Dish.Detail"];
    var statusKey = Model.IsAvailable ? "Status.Available" : "Status.Unavailable";
    var images = Model.Images.OrderByDescending(i => i.IsThumbnail).ThenBy(i => i.Id).ToList();
    var confirmMsg = L["Confirm.Delete"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">@Model.Name</h2>
    <div>
        <a class="btn btn-warning" asp-action="Edit" asp-route-id="@Model.Id">@L["Btn.Edit"]</a>
        <a class="btn btn-secondary" asp-action="Index">@L["Btn.Back"]</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">@L["Dish.Category"]</dt>
    <dd class="col-sm-9">@Model.DishCategory?.Name</dd>

    <dt class="col-sm-3">@L["Dish.Price"]</dt>
    <dd class="col-sm-9">@Model.Price.ToString("#,##0.##")</dd>

    <dt class="col-sm-3">@L["Dish.PrepTime"]</dt>
    <dd class="col-sm-9">
        @Model.PreparationTime @L["Unit.Minutes"]
        <span class="badge bg-info text-dark">@L[DishDisplay.TimeKey(Model.PreparationTime)]</span>
    </dd>

    <dt class="col-sm-3">@L["Dish.Status"]</dt>
    <dd class="col-sm-9"><span class="badge @(Model.IsAvailable ? "bg-success" : "bg-secondary")">@L[statusKey]</span></dd>

    <dt class="col-sm-3">@L["Dish.Description"]</dt>
    <dd class="col-sm-9">@Model.Description</dd>
</dl>

<hr />
<h4>@L["Img.Gallery"]</h4>

@if (!images.Any())
{
    <div class="alert alert-light border">@L["Img.Empty"]</div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var img in images)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card h-100 @(img.IsThumbnail ? "border-primary" : "")">
                    <img src="@img.ImageUrl" class="card-img-top" alt="@Model.Name" style="height:160px;object-fit:cover" />
                    <div class="card-body p-2">
                        @if (img.IsThumbnail)
                        {
                            <span class="badge bg-primary mb-2">@L["Img.Thumbnail"]</span>
                        }
                        <div class="d-flex gap-1 flex-wrap">
                            @if (!img.IsThumbnail)
                            {
                                <form asp-action="SetThumbnail" asp-route-imageId="@img.Id" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-primary">@L["Img.SetThumbnail"]</button>
                                </form>
                            }
                            <form asp-action="DeleteImage" asp-route-imageId="@img.Id" method="post"
                                  onsubmit="return confirm('@confirmMsg')">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@L["Img.Delete"]</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="card card-body">
    <h5>@L["Img.Add"]</h5>
    <form asp-action="AddImage" method="post">
        <input type="hidden" name="dishId" value="@Model.Id" />
        <div class="mb-2">
            <label class="form-label">@L["Img.Url"]</label>
            <input type="text" name="imageUrl" class="form-control" placeholder="https://..." />
        </div>
        <div class="form-check mb-2">
            <input type="checkbox" name="isThumbnail" value="true" id="isThumbnail" class="form-check-input" />
            <label for="isThumbnail" class="form-check-label">@L["Img.MakeThumb"]</label>
        </div>
        <button type="submit" class="btn btn-primary">@L["Img.Add"]</button>
    </form>
</div>
